# Database Configuration
# Default to SQLite for seamless portability and testing; set to MySQL 8.0 for production
DATABASE_URL=sqlite:///./fulfillment.db
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/fulfillment_db

# Application Configuration
APP_NAME=Smart Order Fulfillment and Delivery Promise Optimization System
APP_ENV=development
API_PREFIX=/api
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Random Seed for Reproducibility
SEED=20261022

# Default Optimization Weights (Must sum to 1.0)
WEIGHT_INVENTORY=0.30
WEIGHT_SPEED=0.25
WEIGHT_CAPACITY=0.15
WEIGHT_COST=0.15
WEIGHT_RELIABILITY=0.10
WEIGHT_RISK=0.05
